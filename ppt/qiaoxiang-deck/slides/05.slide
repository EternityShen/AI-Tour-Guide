                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'baseline' }}>
                    <Text style={{ fontSize: 13, color: '#1F2A2E', opacity: 0.6, fontFamily: "'Source Han Sans SC', 'Microsoft YaHei', sans-serif" }}>
                        识别模型加载
                    </Text>
                    <Text style={{ fontSize: 16, color: '#1F2A2E', fontWeight: 'bold', fontFamily: "'Source Han Sans SC', 'Microsoft YaHei', sans-serif" }}>
                        文字问答
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'baseline' }}>
                    <Text style={{ fontSize: 13, color: '#1F2A2E', opacity: 0.6, fontFamily: "'Source Han Sans SC', 'Microsoft YaHei', sans-serif" }}>
                        合成模型加载
                    </Text>
                    <Text style={{ fontSize: 16, color: '#1F2A2E', fontWeight: 'bold', fontFamily: "'Source Han Sans SC', 'Microsoft YaHei', sans-serif" }}>
                        1.5 s
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'baseline' }}>
                    <Text style={{ fontSize: 13, color: '#1F2A2E', opacity: 0.6, fontFamily: "'Source Han Sans SC', 'Microsoft YaHei', sans-serif" }}>
                        本地大模型
                    </Text>
                    <Text style={{ fontSize: 16, color: '#1F2A2E', fontWeight: 'bold', fontFamily: "'Source Han Sans SC', 'Microsoft YaHei', sans-serif" }}>
                        qwen3.5:4b
                    </Text>
                </Box>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: 44, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
        <Text style={{ fontSize: 13, color: '#1F2A2E', opacity: 0.4, fontFamily: "'Source Han Sans SC', 'Microsoft YaHei', sans-serif" }}>

            </Text>

            <Box style={{ width: '100%', height: 1, background: '#1F2A2E', opacity: 0.12 }} />

            <Box style={{ flexDirection: 'column', gap: 10 }}>
                <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'baseline' }}>
